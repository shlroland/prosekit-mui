---
import '../styles/tailwind.css'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ProseKit MUI Playground</title>
  </head>
  <body>
    <main class="mx-auto w-[min(960px,calc(100%-2rem))] py-16">
      <section class="rounded-[2rem] border border-black/8 bg-white/82 p-8 shadow-[0_20px_60px_rgba(23,23,23,0.08)] backdrop-blur-[14px]">
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.22em] text-stone-500">Astrobook Ready</p>
        <h1 class="mb-4 max-w-4xl text-[clamp(2.8rem,8vw,5.4rem)] leading-[0.92] font-extrabold tracking-[-0.06em] text-neutral-950">
          ProseKit MUI playground with Tailwind-first component styling
        </h1>
        <p class="mb-6 max-w-3xl text-lg leading-8 text-stone-600">
          This Astrobook app lives inside the repository and mounts at
          <code>/playground</code>. Use it to iterate on editor buttons, badges,
          toolbars, and future React components with Material UI v7 primitives
          while keeping your own component styling in Tailwind.
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            class="inline-flex min-h-12 items-center justify-center rounded-full bg-neutral-950 px-5 font-bold text-white no-underline"
            href="/playground"
          >
            Open Playground
          </a>
          <a
            class="inline-flex min-h-12 items-center justify-center rounded-full border border-black/12 bg-white/60 px-5 font-bold text-neutral-950 no-underline"
            href="https://github.com/ocavue/astrobook"
          >
            Astrobook Repo
          </a>
        </div>
        <div class="mt-5 grid gap-4 md:grid-cols-3">
          <article class="rounded-[1.25rem] border border-black/8 bg-white/66 p-4">
            <strong>Stories live in</strong>
            <span><code>demo/stories</code></span>
          </article>
          <article class="rounded-[1.25rem] border border-black/8 bg-white/66 p-4">
            <strong>Start dev server</strong>
            <span><code>aube run dev</code></span>
          </article>
          <article class="rounded-[1.25rem] border border-black/8 bg-white/66 p-4">
            <strong>Build output</strong>
            <span><code>aube run build</code></span>
          </article>
        </div>
      </section>
    </main>
  </body>
</html>
