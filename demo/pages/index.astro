---
import '../styles/tailwind.css'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ProseKit MUI Playground</title>
  </head>
  <body>
    <main class="pk:mx-auto pk:w-[min(960px,calc(100%-2rem))] pk:py-16">
      <section class="pk:rounded-[2rem] pk:border pk:border-black/8 pk:bg-white/82 pk:p-8 pk:shadow-[0_20px_60px_rgba(23,23,23,0.08)] pk:backdrop-blur-[14px]">
        <p class="pk:mb-4 pk:text-xs pk:font-bold pk:uppercase pk:tracking-[0.22em] pk:text-stone-500">Astrobook Ready</p>
        <h1 class="pk:mb-4 pk:max-w-4xl pk:text-[clamp(2.8rem,8vw,5.4rem)] pk:leading-[0.92] pk:font-extrabold pk:tracking-[-0.06em] pk:text-neutral-950">
          ProseKit MUI playground with Tailwind-first component styling
        </h1>
        <p class="pk:mb-6 pk:max-w-3xl pk:text-lg pk:leading-8 pk:text-stone-600">
          This Astrobook app lives inside the repository and mounts at
          <code>/playground</code>. Use it to iterate on editor buttons, badges,
          toolbars, and future React components with Material UI v7 primitives
          while keeping your own component styling in Tailwind.
        </p>
        <div class="pk:flex pk:flex-wrap pk:gap-3">
          <a
            class="pk:inline-flex pk:min-h-12 pk:items-center pk:justify-center pk:rounded-full pk:bg-neutral-950 pk:px-5 pk:font-bold pk:text-white pk:no-underline"
            href="/playground"
          >
            Open Playground
          </a>
          <a
            class="pk:inline-flex pk:min-h-12 pk:items-center pk:justify-center pk:rounded-full pk:border pk:border-black/12 pk:bg-white/60 pk:px-5 pk:font-bold pk:text-neutral-950 pk:no-underline"
            href="https://github.com/ocavue/astrobook"
          >
            Astrobook Repo
          </a>
        </div>
        <div class="pk:mt-5 pk:grid pk:gap-4 pk:md:grid-cols-3">
          <article class="pk:rounded-[1.25rem] pk:border pk:border-black/8 pk:bg-white/66 pk:p-4">
            <strong>Stories live in</strong>
            <span><code>demo/stories</code></span>
          </article>
          <article class="pk:rounded-[1.25rem] pk:border pk:border-black/8 pk:bg-white/66 pk:p-4">
            <strong>Start dev server</strong>
            <span><code>aube run dev</code></span>
          </article>
          <article class="pk:rounded-[1.25rem] pk:border pk:border-black/8 pk:bg-white/66 pk:p-4">
            <strong>Build output</strong>
            <span><code>aube run build</code></span>
          </article>
        </div>
      </section>
    </main>
  </body>
</html>
