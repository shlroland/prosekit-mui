{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "noEmit": true,
    "composite": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [
    "demo/**/*.ts",
    "demo/**/*.tsx",
    "demo/**/*.astro",
    "demo/env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/types.d.ts"
  ]
}
